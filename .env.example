# ============================================================
# BuildSage 环境变量示例
# 复制为 .env 后按需填写；.env 已被 .gitignore 忽略，勿提交密钥。
# ============================================================

# --- LLM ---
# provider: deepseek | dashscope | ollama | mock
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DASHSCOPE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
LLM_TIMEOUT_SEC=15

# --- Embedding / Rerank（本地模型）---
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_BATCH_SIZE=64
RERANK_MODEL_NAME=BAAI/bge-reranker-large
# 国内网络建议走 HuggingFace 镜像，否则 BGE-M3 权重可能下载超时
HF_ENDPOINT=https://hf-mirror.com
# 模型缓存位置（可选，默认 ~/.cache/huggingface）
HF_HOME=
HF_HUB_DISABLE_SYMLINKS=1

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_USER=buildsage
MYSQL_PASSWORD=buildsage
MYSQL_DB=buildsage

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6380

# --- 向量库（开发期 Chroma）---
CHROMA_PERSIST_DIR=./data/chroma

# --- 可观测（Langfuse，留空则静默降级为不追踪）---
# 方式 A：Langfuse Cloud 免费版，注册后填 key
# 方式 B：自托管 docker compose --profile langfuse up -d，然后 host 填 http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- 服务 ---
LOG_LEVEL=INFO
